{
  "name": "civicaya",
  "version": "1.0.0",
  "description": "Reclama tu Cívica personalizada sin filas: registra tus datos en la web y solo pasa por el punto de atención del Metro de Medellín a mostrar tu documento.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
