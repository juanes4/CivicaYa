# Copia este archivo a .env y ajusta los valores.
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite
DB_PATH=./civicaya.db

# Solo para `npm run db:init`: crea un usuario administrador inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_contrasena
